# =====================================================================
# SmartGanga Mascot — Backend Environment Configuration
# =====================================================================

# Server Networking
HOST=127.0.0.1
PORT=5000
FLASK_ENV=development
DEBUG=false

# Allowed Frontend Origins (Comma-separated for CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://cha-cha-chaudari.vercel.app

# Cryptographic Authentication Key (Must be 32+ random characters in production)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production
TOKEN_EXP_HOURS=24
ADMIN_CODE=letmein-admin

# Database Connection (MongoDB or fallback in-memory)
MONGODB_URI=mongodb://localhost:27017/chachadb
MONGODB_DB=chachadb

# LLM Provider Configuration: "openrouter" or "local"
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Local LLM Inference Settings
ENABLE_LOCAL_LLM=true
MODEL_PATH=microsoft/Phi-3-mini-4k-instruct
FALLBACK_MODEL_PATH=meta-llama/Llama-2-7b-chat-hf
FORCE_CPU=false
USE_4BIT=true

# Text-To-Speech (TTS) Settings
TTS_ENGINE=piper
TTS_PORT=6001
# Path to local piper executable (e.g. backend/piper/piper.exe on Windows, /usr/local/bin/piper on Linux)
PIPER_PATH=./piper/piper.exe
PIPER_VOICES_DIR=./voices/piper

# API Rate Limiting
RATE_LIMIT_DEFAULT=120 per minute
RATE_LIMIT_LLM=20 per minute

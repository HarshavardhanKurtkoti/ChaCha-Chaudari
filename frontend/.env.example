# =====================================================================
# SmartGanga Mascot — Frontend Environment Configuration (Vite)
# =====================================================================

# Central Backend API Base URL
# Local development default is http://127.0.0.1:5000 (or empty to use Vite /api proxy)
# Production example: https://api.smartganga.example.com
VITE_API_BASE_URL=http://127.0.0.1:5000

# Standalone High-Speed TTS Proxy Base URL
# Runs on port 6001 for low-latency audio generation decoupled from LLM inference
# Falls back to VITE_API_BASE_URL/tts if omitted
VITE_TTS_BASE_URL=http://127.0.0.1:6001

# Google OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Deployed Frontend Public Origin
VITE_FRONTEND_URL=http://localhost:5173
